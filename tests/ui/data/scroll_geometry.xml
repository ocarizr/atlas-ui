<?xml version="1.0"?>
<scroll-cases>
  <case name="empty_extent" width="0" height="0" x="100" y="100" range-x="0" range-y="0"/>
  <case name="shorter" width="20" height="30" x="50" y="50" range-x="0" range-y="0"/>
  <case name="equal" width="100" height="80" x="1000" y="1000" range-x="0" range-y="0"/>
  <case name="vertical" width="100" height="200" x="1000" y="1000" range-x="0" range-y="120"/>
  <case name="horizontal" width="200" height="80" x="1000" y="1000" range-x="100" range-y="0"/>
  <case name="both" width="240" height="350" x="1000" y="1000" range-x="140" range-y="270"/>
  <case name="negative_offset" width="240" height="350" x="-100" y="-100" range-x="140" range-y="270"/>
  <case name="middle" width="240" height="350" x="60" y="70" range-x="140" range-y="270"/>
</scroll-cases>
