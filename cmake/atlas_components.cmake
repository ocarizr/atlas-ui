include_guard(GLOBAL)

set(ATLAS_COMPONENTS "" CACHE STRING "Requested components; empty builds all components")
set(ATLAS_PREBUILT_ROOT "" CACHE PATH "Same-run installed Atlas prerequisites")
set(atlas_component_order jobs streaming ipc application dependencies windows game editor tools jobs-benchmark)
set(atlas_requires_jobs-benchmark jobs)
set(atlas_requires_streaming jobs)
set(atlas_requires_application jobs ipc)
set(atlas_requires_game application)
set(atlas_requires_editor application)
set(atlas_requires_tools application)

set(atlas_requested_components ${ATLAS_COMPONENTS})
if(NOT atlas_requested_components)
    set(atlas_requested_components ${atlas_component_order})
    if(NOT ATLAS_BUILD_WINDOWS_INTEGRATION)
        list(REMOVE_ITEM atlas_requested_components windows)
    endif()
endif()
foreach(component IN LISTS atlas_requested_components)
    if(NOT component IN_LIST atlas_component_order)
        message(FATAL_ERROR "Unknown Atlas component: ${component}")
    endif()
endforeach()
if(windows IN_LIST atlas_requested_components AND NOT ATLAS_BUILD_WINDOWS_INTEGRATION)
    message(FATAL_ERROR "The windows component requires native SDK integration")
endif()
set(atlas_build_components ${atlas_requested_components})
while(TRUE)
    set(previous_components ${atlas_build_components})
    foreach(component IN LISTS atlas_build_components)
        list(APPEND atlas_build_components ${atlas_requires_${component}})
    endforeach()
    list(REMOVE_DUPLICATES atlas_build_components)
    if("${previous_components}" STREQUAL "${atlas_build_components}")
        break()
    endif()
endwhile()

function(atlas_add_library_component component)
    if(NOT component IN_LIST atlas_build_components)
        return()
    endif()
    if(ATLAS_PREBUILT_ROOT AND NOT component IN_LIST atlas_requested_components)
        if(component STREQUAL "jobs")
            find_package(Threads REQUIRED)
        endif()
        set(exports "${ATLAS_PREBUILT_ROOT}/share/atlas/${component}.cmake")
        if(NOT EXISTS "${exports}")
            message(FATAL_ERROR "Missing compiled Atlas prerequisite: ${component}")
        endif()
        include("${exports}")
    else()
        add_subdirectory("libs/${component}")
    endif()
endfunction()
