function(atlas_add_application target source output label argument)
    add_executable(${target} "${PROJECT_SOURCE_DIR}/${source}")
    target_link_libraries(${target} PRIVATE Atlas::Application Atlas::PlatformDependencies)
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${output}")
    atlas_configure_target(${target})
    install(TARGETS ${target} RUNTIME_DEPENDENCY_SET atlas_runtime RUNTIME DESTINATION bin)
    if(BUILD_TESTING)
        add_test(NAME "${output}.EntryPoint" COMMAND ${target} "${argument}")
        set_tests_properties("${output}.EntryPoint" PROPERTIES LABELS "${label}" TIMEOUT 15)
    endif()
endfunction()

atlas_add_application(atlas_game Apps/AtlasGame/Main.cpp AtlasGame game --smoke-test)
atlas_add_application(atlas_editor Apps/AtlasEditor/Main.cpp AtlasEditor editor --smoke-test)
atlas_add_application(atlas_cook Tools/AtlasCook/Main.cpp AtlasCook tools --help)
atlas_add_application(atlas_package Tools/AtlasPackage/Main.cpp AtlasPackage tools --help)
