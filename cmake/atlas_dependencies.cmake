include_guard(GLOBAL)

if(renderer IN_LIST atlas_build_components AND ATLAS_BUILD_WINDOWS_INTEGRATION)
    find_package(directx-dxc CONFIG REQUIRED)
    # The pinned DXC package misspells DXIL's Release location; both configurations ship the same DLL.
    get_target_property(atlas_dxil_location Microsoft::DXIL IMPORTED_LOCATION_DEBUG)
    set_target_properties(Microsoft::DXIL PROPERTIES IMPORTED_LOCATION_RELEASE "${atlas_dxil_location}")
endif()

set(ATLAS_MEMORY_BACKEND "auto" CACHE STRING "Allocation backend: auto, mimalloc or system")
set_property(CACHE ATLAS_MEMORY_BACKEND PROPERTY STRINGS auto mimalloc system)
if(NOT ATLAS_MEMORY_BACKEND MATCHES "^(auto|mimalloc|system)$")
    message(FATAL_ERROR "ATLAS_MEMORY_BACKEND must be auto, mimalloc or system")
endif()
set(atlas_memory_backend "${ATLAS_MEMORY_BACKEND}")
if(atlas_memory_backend STREQUAL "auto")
    if(ATLAS_ENABLE_ASAN)
        set(atlas_memory_backend system)
    else()
        set(atlas_memory_backend mimalloc)
    endif()
endif()
if(ATLAS_ENABLE_ASAN AND atlas_memory_backend STREQUAL "mimalloc")
    message(FATAL_ERROR "The native ASan profile requires the system allocator backend")
endif()
if(memory IN_LIST atlas_build_components AND atlas_memory_backend STREQUAL "mimalloc")
    find_package(mimalloc 3.5 CONFIG REQUIRED)
endif()

if(ipc IN_LIST atlas_build_components)
    find_package(Protobuf CONFIG REQUIRED)
    find_package(gRPC CONFIG REQUIRED)
endif()
if(diagnostics IN_LIST atlas_build_components)
    find_package(spdlog 1.17 CONFIG REQUIRED)
    find_package(yaml-cpp 0.9 CONFIG REQUIRED)
endif()
if(BUILD_TESTING)
    foreach(component window renderer memory memory-integration diagnostics jobs jobs-diagnostics streaming ipc application dependencies windows)
        if(component IN_LIST atlas_requested_components)
            find_package(GTest CONFIG REQUIRED)
            break()
        endif()
    endforeach()
    if(streaming IN_LIST atlas_requested_components OR dependencies IN_LIST atlas_requested_components)
        find_package(Opus CONFIG REQUIRED)
        add_library(atlas_audio_dependencies INTERFACE)
        add_library(atlas::audio_dependencies ALIAS atlas_audio_dependencies)
        target_link_libraries(atlas_audio_dependencies INTERFACE Opus::opus)
    endif()
    if(dependencies IN_LIST atlas_requested_components)
        find_package(EnTT CONFIG REQUIRED)
        find_package(pugixml CONFIG REQUIRED)
        find_package(yaml-cpp CONFIG REQUIRED)
        add_library(atlas_ecs_dependencies INTERFACE)
        add_library(atlas::ecs_dependencies ALIAS atlas_ecs_dependencies)
        target_link_libraries(atlas_ecs_dependencies INTERFACE EnTT::EnTT)
        add_library(atlas_content_dependencies INTERFACE)
        add_library(atlas::content_dependencies ALIAS atlas_content_dependencies)
        target_link_libraries(atlas_content_dependencies INTERFACE pugixml::pugixml yaml-cpp::yaml-cpp)
        include(cmake/atlas_video_dependencies.cmake)
    endif()
endif()
